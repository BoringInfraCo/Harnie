@@ -0,0 +1,4 @@
+export const greet = (name: string): string => {
+  const trimmed = name.trim();
+  return `Hello, ${trimmed || "world"}!`;
+};
diff --git a/tests/greeting.test.ts b/tests/greeting.test.ts
new file mode 100644
index 0000000..5227c04
--- /dev/null
+++ b/tests/greeting.test.ts
@@ -0,0 +1,9 @@
+import { describe, expect, it } from "vitest";
+import { greet } from "../src/greeting.js";
+
+describe("greet", () => {
+  it("greets by name", () => expect(greet("Ada")).toBe("Hello, Ada!"));
+  it("trims the name", () => expect(greet("  Bob ")).toBe("Hello, Bob!"));
+  it("defaults to world when empty", () => expect(greet("")).toBe("Hello, world!"));
+  it("defaults to world when whitespace only", () => expect(greet("   ")).toBe("Hello, world!"));
+});
